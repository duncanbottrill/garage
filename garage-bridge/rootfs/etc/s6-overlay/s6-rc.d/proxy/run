#!/command/with-contenv bashio
# Writes the Tesla vehicle-command private key to /data/private-key.pem
# (600, line breaks restored and validated with openssl) and runs tesla-http-proxy on 127.0.0.1:4443 for the ingest
# telemetry-config manager to talk to. tesla_private_key is optional in
# dev/e2e: when it's empty there is nothing to sign commands with, so we
# log a clear message and idle rather than crash-looping — the rest of
# the stack (telemetry, ingest) still comes up without it.
#
# The proxy's HTTPS listener uses the pair in /data/proxy-tls. The
# listener is served to the tailnet on 4443 as a raw TCP forward, so the
# iPhone/Mac app sees this certificate and needs one it trusts:
# - tailscale_enabled: tlscert writes the Let's Encrypt pair for the
#   node's tailnet FQDN there (`tailscale cert`) and restarts this service
#   when it changes. On a first start this script waits up to 120 s for
#   it; if it is still missing, a self-signed pair is generated so the
#   proxy (and the ingest's telemetry registration) can start, and
#   tlscert replaces it and restarts the proxy once `tailscale cert`
#   succeeds. A pair already there (including the self-signed one from
#   0.2.0) is used as is until tlscert replaces it.
# - tailscale disabled (dev/e2e): a self-signed pair is generated once
#   and reused across restarts, as in 0.2.0.
# The ingest's TelemetryConfigManager connects to 127.0.0.1:4443 with
# insecureTls: true, so either certificate works for it.
#
# Idempotent: re-writing private-key.pem with the same option value is a
# no-op in effect, and the self-signed pair is only generated when no
# pair exists.
set -euo pipefail

PRIVATE_KEY="$(bashio::config 'tesla_private_key')"

if [ -z "${PRIVATE_KEY}" ]; then
  bashio::log.warning "proxy: tesla_private_key is empty, no vehicle command key configured; idling"
  exec sleep infinity
fi

# Home Assistant shows `password` options as a single-line field, so a key
# pasted there loses its line breaks; garage-normalize-pem refolds it into
# a loadable PEM. Validate before handing it to the proxy: a bad key would
# otherwise make tesla-http-proxy exit and s6 restart it every second.
# Never log the key itself.
umask 0177
if ! printf '%s\n' "${PRIVATE_KEY}" | /usr/bin/garage-normalize-pem > /data/private-key.pem.tmp \
    || ! openssl pkey -in /data/private-key.pem.tmp -noout -text 2>/dev/null | grep -q 'ASN1 OID: prime256v1'; then
  rm -f /data/private-key.pem.tmp
  bashio::log.error "proxy: tesla_private_key is not a valid PEM private key. Paste the whole file, including the -----BEGIN/END----- lines; in the YAML editor use the block form 'tesla_private_key: |' with the key indented on the following lines (see the add-on Documentation). Idling until the option is fixed."
  exec sleep infinity
fi
mv /data/private-key.pem.tmp /data/private-key.pem
chmod 600 /data/private-key.pem

PROXY_TLS_DIR=/data/proxy-tls
mkdir -p "${PROXY_TLS_DIR}"

have_pair() {
  [ -s "${PROXY_TLS_DIR}/cert.pem" ] && [ -s "${PROXY_TLS_DIR}/key.pem" ]
}

# Writes a self-signed pair via temp files, and only installs it if no
# pair appeared in the meantime (tlscert may have just written one).
generate_self_signed() {
  openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 3650 \
    -subj "/CN=garage-bridge" \
    -keyout "${PROXY_TLS_DIR}/key.pem.self" -out "${PROXY_TLS_DIR}/cert.pem.self"
  chmod 600 "${PROXY_TLS_DIR}/key.pem.self"
  if have_pair; then
    rm -f "${PROXY_TLS_DIR}/key.pem.self" "${PROXY_TLS_DIR}/cert.pem.self"
    return 0
  fi
  mv "${PROXY_TLS_DIR}/key.pem.self" "${PROXY_TLS_DIR}/key.pem"
  mv "${PROXY_TLS_DIR}/cert.pem.self" "${PROXY_TLS_DIR}/cert.pem"
}

if bashio::config.true 'tailscale_enabled'; then
  waited=0
  while ! have_pair && [ "${waited}" -lt 120 ]; do
    if [ "$((waited % 30))" -eq 0 ]; then
      bashio::log.info "proxy: waiting for the tailnet certificate in ${PROXY_TLS_DIR} (tlscert runs tailscale cert)"
    fi
    sleep 2
    waited=$((waited + 2))
  done
  if have_pair; then
    ISSUER="$(openssl x509 -noout -issuer -in "${PROXY_TLS_DIR}/cert.pem" 2>/dev/null || echo 'issuer=unreadable')"
    bashio::log.info "proxy: using the TLS pair in ${PROXY_TLS_DIR} (${ISSUER})"
  else
    bashio::log.warning "proxy: no tailnet certificate after 120 s; generating a self-signed pair for now (tlscert replaces it and restarts the proxy once tailscale cert succeeds)"
    generate_self_signed
  fi
elif ! have_pair; then
  bashio::log.info "proxy: tailscale disabled; generating a self-signed TLS pair for the proxy listener"
  generate_self_signed
fi

bashio::log.info "proxy: starting tesla-http-proxy on 127.0.0.1:4443"
exec tesla-http-proxy \
  -tls-key /data/proxy-tls/key.pem \
  -cert /data/proxy-tls/cert.pem \
  -key-file /data/private-key.pem \
  -host 127.0.0.1 \
  -port 4443 \
  -verbose
